{
  "name": "distributed-task-scheduler-server",
  "version": "1.0.0",
  "description": "Fault-tolerant distributed task scheduler server",
  "main": "api/server.js",
  "scripts": {
    "start:api": "node api/server.js",
    "start:coordinator": "node services/scheduler-coordinator/index.js",
    "start:dispatcher": "node services/dispatcher/index.js",
    "start:recovery": "node services/recovery/index.js",
    "start:monitor": "node services/worker-monitor/index.js",
    "start:worker": "node worker/index.js",
    "dev:api": "nodemon api/server.js",
    "dev:coordinator": "nodemon services/scheduler-coordinator/index.js",
    "dev:dispatcher": "nodemon services/dispatcher/index.js",
    "dev:worker": "nodemon worker/index.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "etcd3": "^1.1.0",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "prom-client": "^15.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}